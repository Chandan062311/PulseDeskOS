# --- The only key: TypeSafe Jev (live judgments) ---
# Get one at https://console.typesafe.ai/keys  →  paste below  →  restart the API.
# Without it the API still runs: triage/ingest use an offline mock, live routes 503.
TYPESAFE_API_KEY=your-key-here

# --- Storage (segregated via volume in compose) ---
MEMORY_DB=/data/memory.db

# --- Optional overrides ---
# TYPESAFE_ENDPOINT=
# UVICORN_WORKERS=4
# PULSEDESK_RATE_LIMIT=120
# PULSEDESK_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
