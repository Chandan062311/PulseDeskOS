# --- Required: TypeSafe Jev (live judgments) ---
# Get one at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=your-key-here

# --- Required in production: API gate ---
# Sent as X-API-Key header. /healthz stays open for probes.
# Leave empty ONLY for local dev (auth disabled with a warning).
PULSEDESK_API_KEY=change-me-in-production

# --- Storage (segregated via volume in compose) ---
MEMORY_DB=/data/memory.db

# --- Optional overrides ---
# TYPESAFE_ENDPOINT=
# UVICORN_WORKERS=4
